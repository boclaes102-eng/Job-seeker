PORT=8080
DB_PATH=jobs.db

# Ollama settings (free, runs locally)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# How many jobs Ollama scores simultaneously
OLLAMA_NUM_PARALLEL=2

# Adzuna Belgium API — free at developer.adzuna.com (instant sign-up, 25k calls/month)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Comma-separated skills used for AI job matching
SKILLS=React,TypeScript,JavaScript,Node.js,CSS,HTML,REST APIs,Git,Vite,Tailwind
