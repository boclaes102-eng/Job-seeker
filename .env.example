# Copy this file to .env and fill in what you have. Everything is optional:
# ictjob.be and Le Forem work without any key.

# --- Job sources -------------------------------------------------------------
# Jooble: https://jooble.org/api/about  (keys are per country; ask for a Belgium key)
JOOBLE_API_KEY=
JOOBLE_HOST=be.jooble.org

# Adzuna (paid after 25 test calls, £8/month): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- App ---------------------------------------------------------------------
# Your CV (PDF). Relative paths are relative to the project folder.
CV_PDF=CV.pdf
# Run a search automatically every N hours while the app is open (0 = off).
AUTO_SEARCH_HOURS=0
HOST=127.0.0.1
PORT=8000
# DATA_DIR=data
