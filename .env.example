# ─── Adzuna ─────────────────────────────────────────────────────────────────
# Free trial; register at https://developer.adzuna.com to get credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Ollama ─────────────────────────────────────────────────────────────────
# Local LLM used for referee scoring + email drafts.
# Run `ollama pull llama3.2:3b` first.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Concurrency tuning. Bump these if you have a fast machine.
OLLAMA_NUM_PARALLEL=4
HYDRATE_CONCURRENCY=4

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=jobs.db
LOG_PATH=debug.log

# Optional: explicit profile path. Defaults to ../profile.md searching upward.
# PROFILE_PATH=/absolute/path/to/profile.md
